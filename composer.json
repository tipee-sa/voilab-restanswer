{
    "name": "gammadia/voilab-restanswer",
    "type": "library",
    "description": "PSR-7 native REST response library (fork of voilab/restanswer).",
    "replace": {
        "voilab/restanswer": "^0.3"
    },
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "pimple/pimple": "^3.0",
        "psr/http-message": "^1.0|^2.0",
        "gammadia/voilab-serviceanswer": "dev-improve-codebase"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0",
        "slim/psr7": "^1.7",
        "symplify/easy-coding-standard": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Voilab\\Restanswer\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Voilab\\Restanswer\\Test\\": "tests/"
        }
    }
}
